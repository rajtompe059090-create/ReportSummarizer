<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Normal permissions solely for AdMob test ads -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyKit">

        <!-- Google Mobile Ads App ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <!-- Splash Screen Launcher -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DailyKit.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Dashboard Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Calculator -->
        <activity
            android:name=".activities.CalculatorActivity"
            android:exported="false" />

        <!-- EMI Calculator -->
        <activity
            android:name=".activities.EmiCalculatorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- GST Calculator -->
        <activity
            android:name=".activities.GstCalculatorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Discount Calculator -->
        <activity
            android:name=".activities.DiscountCalculatorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Percentage Calculator -->
        <activity
            android:name=".activities.PercentageCalculatorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Age Calculator -->
        <activity
            android:name=".activities.AgeCalculatorActivity"
            android:exported="false" />

        <!-- Date Difference -->
        <activity
            android:name=".activities.DateDifferenceActivity"
            android:exported="false" />

        <!-- Countdown -->
        <activity
            android:name=".activities.CountdownActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- BMI Calculator -->
        <activity
            android:name=".activities.BmiCalculatorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Unit Converter -->
        <activity
            android:name=".activities.UnitConverterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notes -->
        <activity
            android:name=".activities.NotesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Note Edit -->
        <activity
            android:name=".activities.NoteEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- About -->
        <activity
            android:name=".activities.AboutActivity"
            android:exported="false" />

        <!-- Privacy Policy -->
        <activity
            android:name=".activities.PrivacyPolicyActivity"
            android:exported="false" />

        <!-- Support -->
        <activity
            android:name=".activities.SupportActivity"
            android:exported="false" />

    </application>

</manifest>
